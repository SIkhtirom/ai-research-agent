# Secrets and local state must never be baked into an image.
.env
.env.*
!.env.example

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/

# Local runtime data (SQLite, FAISS/Chroma store, uploaded temp files)
data/
*.sqlite3
*.db
.ai-research-ingest/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
