# Copy to `.env` and fill in real values. DO NOT commit `.env` to version control.

# --- LLM / provider ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://xkiro.com/v1
OPENAI_MODEL=deepseek/deepseek-chat-v3.1

# --- Embeddings ---
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- CORS (override as needed) ---
# Comma-separated browser origins the API will answer.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to 1 to accept ANY origin (used by expose.sh for NGrok/localTunnel).
# Safe here because the API never sends cookies/credentials.
CORS_ALLOW_ANY_ORIGIN=0