# Copy to `.env.local` and adjust. NEXT_PUBLIC_* values are inlined by Next.js
# at start/build time (see frontend/lib/api/client.ts).

# Origin of the backend API. Only the origin is required; the client appends
# "/api/v1" automatically. Leave unset to use the local dev default.
#   Local dev:  http://127.0.0.1:8000
#   Tunnel:     https://your-tunnel.ngrok-free.app   (expose.sh sets this)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000